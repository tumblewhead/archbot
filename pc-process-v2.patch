+version: 2
+id: AP-SELECT-002
+status: approved_for_trial
+authority: user_agreement_to_progressive_verification_and_provisional_commitment
+original_f: F-001
+# Does not modify F-001's hard requirements or its final SRAM/cycle/flash Pareto ranking.
+selection_kind: PROVISIONAL_COMMITMENT
+stages: [AS, AP, CON, DE, IMPLEMENTATION, TARGET_VALIDATION]
+requirements: [C-001, C-002, C-003, R-001, R-002, R-003]
+# Only the governing policy (not an agent-authored assessment) sets AP-due checks.
+ap_due_requirements: [C-001, C-002, C-003, R-001, R-002, R-003]
+allowed_stage_states: [SATISFIED, CONDITIONALLY_SATISFIED, DEFERRED]
+future_evidence_required: [owner, method, due_stage, acceptance, assumptions, escalation]
+protected_scope_decisions: [C-002]
+f_dimensions: [state_sram_bytes, worst_case_cycles_per_update, flash_bytes]
+selection_rules:
+  - All AP-due assessments must have admissible evidence and required assumptions.
+  - Deferred final checks must remain open VOs with complete plans.
+  - No known hard violation or unresolved AP-due evidence can be ignored.
+  - A stakeholder-authorized provisional commitment may resolve an incomplete projected F comparison, but may not claim a Pareto winner.
+  - Final acceptance requires every binding VO to be discharged with accepted evidence.
+  - Revisions to AS or F require separate authorized versioned decisions.
